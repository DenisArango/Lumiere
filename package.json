{
  "name": "lumiere",
  "private": true,
  "description": "Lumiere - portal de gestion de cartelera de cine y venta de boletos en linea",
  "scripts": {
    "dev:backend": "pnpm --filter @lumiere/backend dev",
    "dev:frontend": "pnpm --filter @lumiere/frontend dev",
    "build:backend": "pnpm --filter @lumiere/backend build",
    "build:frontend": "pnpm --filter @lumiere/frontend build",
    "test:backend": "pnpm --filter @lumiere/backend test",
    "lint:backend": "pnpm --filter @lumiere/backend lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0"
}
