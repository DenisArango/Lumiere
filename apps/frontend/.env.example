# La clave publicable de Stripe y el Client ID de PayPal ya NO van aqui: los entrega el backend en tiempo de
# ejecucion (GET /api/v1/payments/config), configurados en apps/backend/.env.
#
# Moneda con la que se muestran los precios (ISO-4217). Debe coincidir con PAYMENT_CURRENCY del backend.
VITE_CURRENCY=GTQ
