# Copiar a .env y completar con valores reales. Nunca versionar .env.

NODE_ENV=development
PORT=4000

# Postgres (debe coincidir con docker-compose.yml en desarrollo - puerto 5433,
# no 5432, para no chocar con una instalacion nativa de Postgres en el host)
DATABASE_URL=postgresql://lumiere:lumiere_dev_password@localhost:5433/lumiere?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT - generar secretos fuertes, minimo 32 caracteres (ej. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_DOMAIN=localhost

# CORS - lista separada por comas de origenes permitidos
CORS_ORIGIN=http://localhost:5173

# Stripe
# Moneda de cobro (ISO-4217). Debe coincidir con VITE_CURRENCY del frontend.
PAYMENT_CURRENCY=GTQ
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
PAYPAL_ENV=sandbox

# Bloqueo temporal de asientos (segundos)
SEAT_LOCK_TTL_SECONDS=480
# PayPal no soporta todas las monedas (GTQ no). Si PAYPAL_CURRENCY != PAYMENT_CURRENCY, el cobro en PayPal
# se convierte con PAYPAL_RATE = unidades de PAYMENT_CURRENCY por 1 unidad de PAYPAL_CURRENCY (valor de ejemplo).
PAYPAL_CURRENCY=USD
PAYPAL_RATE=7.7
# ID del webhook registrado en el panel de PayPal (necesario para verificar sus eventos).
PAYPAL_WEBHOOK_ID=
# Tu cuenta de Stripe cobra en MXN: el programa trabaja en PAYMENT_CURRENCY (GTQ) y solo el cobro se convierte.
# STRIPE_RATE = unidades de PAYMENT_CURRENCY por 1 unidad de STRIPE_CURRENCY (valor de ejemplo: confirmalo).
STRIPE_CURRENCY=MXN
STRIPE_RATE=0.42

# --- Produccion (Render) ---
# Carpeta del frontend compilado: si se define, este mismo servidor entrega el sitio (un solo servicio).
# FRONTEND_DIST=/app/apps/frontend/dist
# Saltos de proxy delante de la app (Render = 1).
# TRUST_PROXY=1
# Primer super administrador (solo se usa si todavia no existe ninguno; quitalo despues del primer arranque).
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
